# API 配置
VITE_API_BASE_URL=/api

# draw.io 自部署地址（可选覆盖，默认走同源 /vendor/drawio/，
# 该目录由 `npm run drawio:install` 生成并被后端静态托管）
# VITE_DRAWIO_BASE_URL=http://localhost:8787/vendor/drawio/

# 每日配额（未配置自定义 LLM 时的每日使用次数限制）
DAILY_QUOTA=10

# 数据库文件路径（默认 data/nexus.db，Docker 中挂载 /app/data）
# DATABASE_PATH=/app/data/nexus.db
