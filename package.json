{
  "name": "ai-draw-nexus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend-go\"",
    "dev:frontend": "vite",
    "dev:backend-go": "cd backend && go run ./cmd/server",
    "drawio:install": "node tools/install-drawio.mjs",
    "build": "tsc -b && vite build",
    "start:go": "cd backend && go run ./cmd/server",
    "lint": "eslint .",
    "test:go": "cd backend && go test ./...",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.9.1",
    "@excalidraw/excalidraw": "^0.18.0",
    "@mermaid-js/layout-elk": "^0.2.0",
    "@mermaid-js/layout-tidy-tree": "^0.2.0",
    "@phosphor-icons/react": "2.1.10",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "echarts": "^6.1.0",
    "framer-motion": "^12.29.3",
    "mammoth": "^1.11.0",
    "mermaid": "^11.12.2",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-drawio": "^1.0.7",
    "react-router-dom": "^7.11.0",
    "react-simple-code-editor": "^0.14.1",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0"
  }
